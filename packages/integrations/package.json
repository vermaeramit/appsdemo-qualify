{
  "name": "@qualify/integrations",
  "version": "0.0.0",
  "private": true,
  "description": "External integrations: Meta webhooks + WhatsApp Cloud API client, crypto helpers.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
