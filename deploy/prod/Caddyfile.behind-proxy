# Shared server (D-093): the server's own Caddy owns the public address and TLS, and forwards
# this product's domain here over the private "qualify-edge" network. Plain HTTP on :80.
{
	auto_https off
	servers {
		# Trust the forwarding Caddy (private Docker addresses), so the visitor's IP and the https
		# scheme reach the api (per-visitor rate limits, secure cookies).
		trusted_proxies static private_ranges
	}
}

# Security headers on every response, the 404 page included (an error response starts with fresh
# headers, so handle_errors imports them again).
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

:80 {
	# Live updates are a Server-Sent Events stream (D-079): never buffer or compress it.
	@compressible not path /api/live
	encode @compressible zstd gzip

	# API, Better Auth, Meta webhooks: all under /api (D-035).
	handle /api/* {
		reverse_proxy api:3000
	}

	# Marketing website (D-101): the domain's root, its files under /site/, robots and sitemap.
	handle / {
		root * /srv/site
		rewrite * /index.html
		header Cache-Control "no-cache"
		file_server
	}
	# The home page has one address (D-102): /site/ and /site/index.html redirect to /.
	@siteHome path /site/ /site/index.html
	redir @siteHome / 308
	# One address per page (D-104): "/travel/" redirects to "/travel", keeping the query.
	@trailingSlash {
		path_regexp trailingSlash ^(/.+)/$
		not path /api/* /site/*
	}
	redir @trailingSlash {re.trailingSlash.1}{?query} 308
	handle /site/* {
		root * /srv
		@siteAssets path /site/assets/*
		header @siteAssets Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	@siteMeta path /robots.txt /sitemap.xml /llms.txt
	handle @siteMeta {
		root * /srv/site
		file_server
	}

	# Dashboard pages (D-103): only the app's own routes get its HTML with status 200. Keep this list
	# in step with apps/web/src/routes (apps/web/src/caddy-routes.test.ts checks it).
	@appPages path_regexp (?i)^/(dashboard|login|signup|onboarding|admin|agent|api-docs|conversations|costs|integrations|leads|logs|meta-leads|settings|templates)(/.*)?$
	handle @appPages {
		root * /srv
		rewrite * /index.html
		header Cache-Control "no-cache"
		file_server
	}

	# The website's other pages (D-104: /<page> is the pre-rendered /site/<page>/index.html) and the
	# dashboard's files. Hashed assets are cached for a year, the rest never.
	handle {
		root * /srv
		try_files /site{path}/index.html {path}
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@other not path /assets/*
		header @other Cache-Control "no-cache"
		file_server
	}

	# Neither a page nor a file: a real 404 for search engines, with the dashboard's HTML (noindex),
	# so a visitor sees "Page not found".
	handle_errors 404 {
		import security_headers
		root * /srv
		rewrite * /index.html
		header Cache-Control "no-cache"
		file_server
	}

	import security_headers

	log {
		output stdout
		format json
	}
}
