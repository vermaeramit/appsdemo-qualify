# Production entry point: TLS (automatic, Let's Encrypt), the dashboard, and /api → api.
# APP_DOMAIN comes from the environment (white-label later), e.g. qualify.appsdemo.in.
{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	# Live updates are a Server-Sent Events stream (D-079): never buffer or compress it.
	@compressible not path /api/live
	encode @compressible zstd gzip

	# API, Better Auth, Meta webhooks: all under /api (D-035).
	handle /api/* {
		reverse_proxy api:3000 {
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Marketing website (D-101): the domain's root, its files under /site/, robots and sitemap.
	handle / {
		root * /srv/site
		rewrite * /index.html
		header Cache-Control "no-cache"
		file_server
	}
	# The home page has one address (D-102): /site/ and /site/index.html redirect to /.
	@siteHome path /site/ /site/index.html
	redir @siteHome / 308
	handle /site/* {
		root * /srv
		@siteAssets path /site/assets/*
		header @siteAssets Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	@siteMeta path /robots.txt /sitemap.xml
	handle @siteMeta {
		root * /srv/site
		file_server
	}

	# Dashboard (Vite build). Hashed assets are cached for a year; index.html never.
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html not path /assets/*
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	log {
		output stdout
		format json
	}
}
