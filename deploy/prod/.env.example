# Production environment for deploy/prod/compose.yaml. Copy to deploy/prod/.env on the server
# (chmod 600). Never commit the real file. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# Images built by .github/workflows/release.yml (GHCR), e.g. ghcr.io/<github-owner>/appsdemo-qualify
IMAGE_PREFIX=
IMAGE_TAG=latest

# Public address (Caddy gets the TLS certificate for it) and the e-mail for Let's Encrypt.
APP_DOMAIN=qualify.example.com
ACME_EMAIL=ops@example.com
APP_BASE_URL=https://qualify.example.com

# Database: owner (migrations only) and the qualify_app role (api/worker, RLS applies).
POSTGRES_PASSWORD=
QUALIFY_APP_PASSWORD=

# Auth: at least 32 random characters.
BETTER_AUTH_SECRET=
# Encrypts tenant Meta tokens and webhook secrets (base64 of 32 random bytes). Back it up:
# without it stored tokens can't be decrypted.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_MASTER_KEY=

LOG_LEVEL=info

# Meta app (docs/META_SETUP.md). Webhook callback: https://<APP_DOMAIN>/api/webhooks/meta
META_APP_ID=
META_APP_SECRET=
# Embedded Signup configuration id (Facebook Login for Business). Empty = connect by script.
META_ES_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
# META_GRAPH_VERSION=v24.0

# AI (D-039/D-040)
LLM_PROVIDER=openai
# AppsDemo's own OpenAI key (D-094): used only for workspaces a platform admin switches onto
# "AppsDemo's key" (with a monthly limit). Clients can save their own key in Settings → AI instead.
# AI_MODEL_CHAT is the default model; the models clients can pick and their prices live in the
# platform admin page (AI models & prices).
OPENAI_API_KEY=
AI_MODEL_CHAT=gpt-5.4-mini
AI_REASONING_EFFORT=low
AI_DEBOUNCE_MS=4000

# Off-site backups (deploy/prod/backup.sh). Leave empty to keep local copies only.
# Any rclone remote, e.g. "r2:qualify-backups" (configure with `rclone config` on the server).
BACKUP_RCLONE_REMOTE=
BACKUP_KEEP_DAYS=14

# Platform admin page (/admin): comma-separated e-mails of AppsDemo operators. They can also open
# a client's workspace read-only for 60 minutes (support access, D-092). Removing an e-mail ends
# its open accesses at once.
PLATFORM_ADMIN_EMAILS=

# Scheduled e-mail reports (D-088): a transactional e-mail provider's SMTP (Brevo, ZeptoMail,
# Amazon SES…). smtp://user:pass@host:587 (STARTTLS) or smtps://user:pass@host:465.
# Both are required, or reports are saved but not sent. Verify the sender's domain (SPF/DKIM)
# with the provider so reports don't land in spam.
SMTP_URL=
# MAIL_FROM example: Qualify Reports <reports@your-domain.com>
MAIL_FROM=
APP_NAME=AppsDemo Qualify
