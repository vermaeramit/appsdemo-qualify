{
  "name": "appsdemo-qualify",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "pnpm run build:packages && pnpm --parallel --recursive --stream run dev",
    "build": "pnpm --recursive run build",
    "build:packages": "pnpm --filter \"./packages/**\" run build",
    "typecheck": "pnpm run build:packages && pnpm --recursive run typecheck",
    "db:migrate": "pnpm --filter @qualify/db db:migrate",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run build:packages && pnpm --recursive run test",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
