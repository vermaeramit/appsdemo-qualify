# Copy to .env for local development. Never commit .env.

NODE_ENV=development
API_PORT=3000
APP_BASE_URL=http://localhost:5173

# Local infra from compose.yaml (dev-only credentials)
# DATABASE_URL = database owner: used ONLY for migrations.
DATABASE_URL=postgres://qualify:qualify_dev_password@localhost:5434/qualify
# APP_DATABASE_URL = qualify_app role: used by api/worker, so RLS applies.
APP_DATABASE_URL=postgres://qualify_app:qualify_app_dev_password@localhost:5434/qualify
REDIS_URL=redis://localhost:6380
SEQ_URL=http://localhost:5341

# Auth (generate a real one: node -e "console.log(crypto.randomBytes(32).toString('base64url'))")
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Filled in later milestones (keep real values only in .env)
# AI (M3): provider "openai" now; "openrouter" optional for cross-provider comparisons (D-039).
# Used by the worker (live agent) and the api (test chat on the AI agent page).
LLM_PROVIDER=openai
# AppsDemo's own OpenAI key (D-094): used only for workspaces a platform admin switches onto
# "AppsDemo's key" (with a monthly limit). Clients can save their own key in Settings → AI instead.
# AI_MODEL_CHAT is the default model; the models clients can pick and their prices live in the
# platform admin page (AI models & prices).
OPENAI_API_KEY=
AI_MODEL_CHAT=gpt-5.4-mini
AI_REASONING_EFFORT=low
AI_DEBOUNCE_MS=4000
# OPENROUTER_API_KEY=
# Encrypts tenant WhatsApp tokens at rest: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
# Used by the worker (sending) and the api (opening template submit/status). Same value for both.
ENCRYPTION_MASTER_KEY=

# Meta / WhatsApp (M2). Where to find each value: docs/META_SETUP.md
META_APP_ID=
META_APP_SECRET=
# Embedded Signup (Settings → Connect WhatsApp): Facebook Login for Business configuration id
# (Meta app → Facebook Login for Business → Configurations). Empty = the button stays hidden.
META_ES_CONFIG_ID=
# Any random string you choose; enter the same value in the Meta webhook settings.
META_WEBHOOK_VERIFY_TOKEN=
# Our own AppsDemo number, used for development and demos (D-034).
WHATSAPP_DEV_PHONE_NUMBER_ID=
WHATSAPP_DEV_WABA_ID=
WHATSAPP_SYSTEM_USER_TOKEN=
# Optional: a system-user token with pages_show_list, pages_read_engagement, pages_manage_metadata
# and leads_retrieval, for connect-dev-page (lead forms). Falls back to WHATSAPP_SYSTEM_USER_TOKEN.
META_PAGES_TOKEN=
# Dev safety switch: in development the bot messages ONLY these numbers (comma-separated, with
# country code). Empty = nobody. "*" = every number (switch off; production always messages everyone).
DEV_ALLOWED_NUMBERS=

# Platform admin page (/admin): comma-separated e-mails of AppsDemo operators. They can also open
# a client's workspace read-only for 60 minutes (support access, D-092). Removing an e-mail ends
# its open accesses at once.
PLATFORM_ADMIN_EMAILS=

# Scheduled e-mail reports (D-088). Any SMTP provider (Brevo, ZeptoMail, Amazon SES…):
# smtp://user:pass@host:587 (STARTTLS) or smtps://user:pass@host:465. Leave empty in development
# to use Mailpit from compose.yaml (inbox: http://localhost:8025). Production needs both values.
# A server saved on the platform admin page (Email (SMTP), D-095) takes precedence over these.
SMTP_URL=
MAIL_FROM=
# Product name shown in e-mails.
APP_NAME=AppsDemo Qualify

# --- Marketing website (apps/site, D-101). Read at build time (Docker: --build-arg). ---
# Public address (canonical URL, link previews, sitemap). Empty in development.
VITE_SITE_URL=
# WhatsApp number the "Try it on WhatsApp" buttons open, with country code (e.g. 919812345678).
# Empty: the buttons open the sign-up page instead.
VITE_SITE_WHATSAPP_NUMBER=
# Product name on the website (defaults to "AppsDemo Qualify").
VITE_SITE_PRODUCT_NAME=
# Where the dashboard runs. Empty in production (same domain); http://localhost:5173 in development.
VITE_SITE_APP_URL=http://localhost:5173
# The company behind the product (Organization data for search engines, D-103). Empty: left out.
VITE_SITE_COMPANY_NAME=
# The company's public profiles, comma-separated https URLs (LinkedIn, Facebook Page, YouTube…).
VITE_SITE_SOCIAL_LINKS=
