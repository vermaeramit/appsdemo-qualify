{
  "name": "@qualify/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS (Fastify) API: dashboard APIs, auth, Meta webhooks, Socket.IO gateway.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "auth:schema": "pnpm dlx auth@1.7.25 generate --config better-auth.cli.ts --output ../../packages/db/src/schema/auth.ts -y"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-fastify": "^12.5.0",
    "@qualify/db": "workspace:*",
    "@qualify/shared": "workspace:*",
    "better-auth": "^1.7.25",
    "fastify": "^5.12.8",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@types/node": "^26.6.6",
    "pino-pretty": "^13.2.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
