{
  "name": "@qualify/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Background worker: BullMQ processors for ingestion, conversation, scoring, follow-ups and outbound webhooks.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "connect-dev-number": "node --env-file-if-exists=../../.env src/scripts/connect-dev-number.ts",
    "set-dev-webhook": "node --env-file-if-exists=../../.env src/scripts/set-dev-webhook.ts",
    "install-playbook": "node src/scripts/install-playbook.ts",
    "eval": "node src/evals/run-eval.ts",
    "create-api-key": "node src/scripts/create-api-key.ts",
    "opening-template": "node src/scripts/opening-template.ts"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@qualify/core": "workspace:*",
    "@qualify/db": "workspace:*",
    "@qualify/integrations": "workspace:*",
    "@qualify/shared": "workspace:*",
    "bullmq": "^6.7.6",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  }
}
